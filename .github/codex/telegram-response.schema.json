{
  "type": "object",
  "additionalProperties": false,
  "required": ["responses", "change_summary"],
  "properties": {
    "responses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message_id", "status", "reply"],
        "properties": {
          "message_id": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": ["updated", "clarification", "answered", "unsupported", "no_change"]
          },
          "reply": {
            "type": "string"
          }
        }
      }
    },
    "change_summary": {
      "type": "string"
    }
  }
}
